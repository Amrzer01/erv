# ==========================================
# Dokploy / Production Environment Variables
# ==========================================

# 1. Supabase Settings (Database & Auth & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 2. WhatsApp Bot API URL
# Put the public domain/IP of your bot server (e.g., https://bot.yourdomain.com or http://VPS_IP:3001)
NEXT_PUBLIC_BOT_API_URL=http://localhost:3001

# 3. Server Configuration
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0
